{
  "weights": "IMAGENET1K_V2",
  "preprocessing": {
    "image_size": [224, 224],
    "resize_mode": "full_image",
    "interpolation": "bilinear",
    "antialias": true,
    "crop": "none",
    "remove_blank_edges": false,
    "normalization": "weight_preset"
  },
  "training_augmentation": {
    "rotation_degrees": 10,
    "translate": [0.05, 0.05],
    "horizontal_flip_probability": 0.5,
    "interpolation": "bilinear",
    "fill": 0
  },
  "smoke_test": {
    "seed": 0,
    "batch_size": 6,
    "batches_per_split": 3,
    "num_workers": [0, 2],
    "deterministic_algorithms": false
  }
}
